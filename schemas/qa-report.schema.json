{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/qa-report.schema.json",
  "title": "QA Report",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "generated_at",
    "status",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "warn"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "status",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warn",
              "info"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "warn",
              "skip"
            ]
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "video": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frames": {
          "type": "integer",
          "minimum": 0
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "md5": {
          "type": "string"
        },
        "streams": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "silent_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "promoted_from": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "ocr": {
      "type": "object",
      "additionalProperties": true
    },
    "content_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scene": {
            "type": "string"
          },
          "concept": {
            "type": "string"
          },
          "storyboard": {
            "type": "boolean"
          },
          "storyboard_anchors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
